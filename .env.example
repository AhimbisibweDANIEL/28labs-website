# ==============================================================================
# 28 Labs Environment Configuration
# ==============================================================================

# Destination inbox where customer project inquiries are delivered
# Defaults to hello@28labs.net if left empty
CONTACT_EMAIL="hello@28labs.net"

# Transactional sender address for notification emails
# For Resend testing: "28 Labs Inquiries <onboarding@resend.dev>"
# For production: verified domain email like "inquiries@28labs.net"
CONTACT_FROM_EMAIL="28 Labs Inquiries <onboarding@resend.dev>"

# Resend API Key (from https://resend.com/api-keys)
# When configured, lead notifications are delivered to CONTACT_EMAIL in real-time.
# If left empty during development/evaluation, inquiries are validated and logged to the server console.
RESEND_API_KEY=""

# Standalone Express production server port (default: 3000)
PORT=3000

# GEMINI_API_KEY: Optional key for Gemini AI API calls (if using AI features)
GEMINI_API_KEY=""

# APP_URL: Optional hosted app URL (e.g., https://28labs.net)
APP_URL=""
